; --- EXAMPLE 2: Passing a file path still works as before ---
; Local $num = _OCR("F:\Downloads\firefox_3qEvbb5SlD.png")


; ==========================================
; FUNCTION: _OCR (Supports both File Paths & Base64 Strings)
; ==========================================
Func _OCR($sInput)
    Local $sRawBase64 = ""
    Local $sMimeType = "image/png" ; Default MIME type

    ; --- 1. Check if $sInput is a file path or a Base64 string ---
    If FileExists($sInput) Then
        ; It's a file on disk
        $sRawBase64 = _FileToBase64($sInput)
        If StringRight($sInput, 4) = ".jpg" Or StringRight($sInput, 5) = ".jpeg" Then $sMimeType = "image/jpeg"
    ElseIf StringInStr($sInput, "data:image/") Then
        ; It's a Data URL from an <img> tag (e.g., "data:image/png;base64,iVBOR...")
        Local $aParts = StringRegExp($sInput, "data:(image/\w+);base64,(.+)", 1)
        If Not @error Then
            $sMimeType = $aParts[0]
            $sRawBase64 = $aParts[1]
        Else
            ; Fallback: strip header manually if regex missed
            $sRawBase64 = StringTrimLeft($sInput, StringInStr($sInput, ","))
        EndIf
    Else
        ; Assume it's already a raw Base64 string
        $sRawBase64 = StringStripWS($sInput, 8)
    EndIf

    If $sRawBase64 = "" Then
        ConsoleWrite("Error: Could not obtain Base64 data." & @CRLF)
        Return ""
    EndIf

    ; Prepare formats needed for APIs
    Local $sDataUrl = "data:" & $sMimeType & ";base64," & $sRawBase64

    Local $sExtractedNumber = ""
    Local $oHTTP = ObjCreate("WinHttp.WinHttpRequest.5.1")

    ; --- CONFIG ---
    Local $sGroqApiKey = "asd"
    Local $sGroqModel = "qwen/qwen3.6-27b#"

    Local $sGeminiApiKey = "qd"
    Local $aGeminiModels[5] = ["gemini-flash-lite-latest", "gemini-3.1-flash-lite", "gemini-flash-latest", "gemini-3.5-flash", "gemini-3-flash-preview"]

    Local $sOpenRouterApiKey = "sdfs"
    Local $sOpenRouterModel = "nvidia/nemotron-nano-12b-v2-vl:free"

    While $sExtractedNumber = ""

        ; ==========================================================
        ; 1. GEMINI API (Requires RAW base64 without prefix)
        ; ==========================================================
        ConsoleWrite("Trying Gemini..." & @CRLF)
        For $i = 0 To UBound($aGeminiModels) - 1
            Local $sCurrentModel = $aGeminiModels[$i]
            ConsoleWrite("Trying Gemini model: " & $sCurrentModel & @CRLF)

            $oHTTP.Open("POST", "https://generativelanguage.googleapis.com/v1beta/models/" & $sCurrentModel & ":generateContent?key=" & $sGeminiApiKey, False)
            $oHTTP.SetRequestHeader("Content-Type", "application/json")
            
            ; Payload uses $sRawBase64 (NO data:image prefix)
            $oHTTP.Send('{"contents":[{"parts":[{"inlineData": {"mimeType": "' & $sMimeType & '", "data": "' & $sRawBase64 & '"}}, {"text": "Extract the text. Output only the text"}]}]}')

            If $oHTTP.Status = 200 Then
                Local $aMatch = StringRegExp($oHTTP.ResponseText, '"text":\s*"(.*?)"', 1)
                If Not @error Then
                    $sExtractedNumber = StringStripWS(StringReplace($aMatch[0], "\n", ""), 3)
                    If $sExtractedNumber <> "" Then ExitLoop
                EndIf
            EndIf
        Next

        If $sExtractedNumber <> "" Then ExitLoop

        ; ==========================================================
        ; 2. GROQ API (Requires Data URL format)
        ; ==========================================================
        ConsoleWrite("Trying Groq..." & @CRLF)
        $oHTTP.Open("POST", "https://api.groq.com/openai/v1/chat/completions", False)
        $oHTTP.SetRequestHeader("Authorization", "Bearer " & $sGroqApiKey)
        $oHTTP.SetRequestHeader("Content-Type", "application/json")
        
        ; Payload uses $sDataUrl ("data:image/...;base64,...")
        $oHTTP.Send('{"model": "' & $sGroqModel & '", "temperature": 0, "messages": [{"role": "system", "content": "Extract the text. Output only the text"}, {"role": "user", "content": [{"type": "text", "text": "Extract number."}, {"type": "image_url", "image_url": {"url": "' & $sDataUrl & '"}}]}]}')

        If $oHTTP.Status = 200 Then
            Local $aMatch = StringRegExp($oHTTP.ResponseText, '"content":\s*"(.*?)"', 1)
            If Not @error Then
                $sExtractedNumber = StringStripWS($aMatch[0], 3)
                If $sExtractedNumber <> "" Then ExitLoop
            EndIf
        EndIf

        ; ==========================================================
        ; 3. OPENROUTER API (Requires Data URL format)
        ; ==========================================================
        ConsoleWrite("Trying OpenRouter..." & @CRLF)
        $oHTTP.Open("POST", "https://openrouter.ai/api/v1/chat/completions", False)
        $oHTTP.SetRequestHeader("Authorization", "Bearer " & $sOpenRouterApiKey)
        $oHTTP.SetRequestHeader("Content-Type", "application/json")
        $oHTTP.Send('{"model": "' & $sOpenRouterModel & '", "messages": [{"role": "user", "content":[{"type": "text", "text": "Extract only the number."}, {"type": "image_url", "image_url": {"url": "' & $sDataUrl & '"}}]}]}')

        If $oHTTP.Status = 200 Then
            Local $aMatch = StringRegExp($oHTTP.ResponseText, '"content":\s*"(.*?)"', 1)
            If Not @error Then $sExtractedNumber = StringStripWS($aMatch[0], 3)
        EndIf

        If $sExtractedNumber = "" Then
            ConsoleWrite("All APIs failed. Retrying in 5 seconds..." & @CRLF)
            Sleep(5000)
        EndIf
    WEnd

    Return $sExtractedNumber
EndFunc

Func _FileToBase64($sFilePath)
    Local $hFile = FileOpen($sFilePath, 16)
    If $hFile = -1 Then Return ""
    Local $bData = FileRead($hFile)
    FileClose($hFile)

    Local $oXml = ObjCreate("MSXML2.DOMDocument")
    Local $oElement = $oXml.createElement("b64")
    $oElement.dataType = "bin.base64"
    $oElement.nodeTypedValue = $bData
    Return StringReplace(StringReplace($oElement.text, @CR, ""), @LF, "")
EndFunc
